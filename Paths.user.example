<Project>
  <PropertyGroup>
    <!-- Folder containing Railroader.exe. Copy this file to Paths.user and edit. -->
    <GameDir>$(HOME)/.local/share/Steam/steamapps/common/Railroader</GameDir>
    <!-- Debug builds deploy here. On Windows: Documents\Railroader\ModDev\PipTip.
         On Linux/Proton it's inside the game's Proton prefix: -->
    <ModDevDir>$(HOME)/.local/share/Steam/steamapps/compatdata/1683150/pfx/drive_c/users/steamuser/Documents/Railroader/ModDev/PipTip</ModDevDir>
  </PropertyGroup>
</Project>
